# --- Pipeline working data (~2.4 GB): papers, embeddings, LLM outputs, caches, batch state ---
# Everything here is regenerated by ./run_all.sh. Keep only the human-readable audit report.
data/*
!data/audit_report.md

# --- Private docs: pipeline internals, setup, costs and operations notes (not published) ---
docs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Logs and scratch output ---
*.log
nohup.out

# --- Secrets ---
# API keys live outside the repo (~/.config/semanticscholar.env, AWS credentials), but never commit
# environment files even if one is created here by mistake.
.env
.env.*
*.env

# --- Datamapplot data files written to the working directory by mistake (real ones go in site/) ---
/pipeline/data_*.zip

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
