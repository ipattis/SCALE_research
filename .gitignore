# --- Pipeline working data (~600 MB): papers, page cache, embeddings, LLM outputs, batch state ---
# Everything here is regenerated by ./run_all.sh. Keep only the two human-readable reports,
# which the README links to.
data/*
!data/audit_report.md
!data/insights.md

# --- Private docs: setup, AWS / API keys, costs and operations notes (not published) ---
docs/

# --- Published site: site/ IS committed (GitHub Pages serves it). Ignore only local scratch in it ---
site/*.tmp
site/**/.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Logs and scratch output ---
*.log
nohup.out
/tmp/

# --- Secrets ---
# API keys live outside the repo (~/.config/semanticscholar.env, AWS credentials), but never commit
# environment files even if one is created here by mistake.
.env
.env.*
*.env
*.pem

# --- Datamapplot data files written to the working directory by mistake (real ones go in site/) ---
/pipeline/data_*.zip
/data_*.zip

# --- Test artefacts ---
/tests/*.png
/test-results/
/playwright-report/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
